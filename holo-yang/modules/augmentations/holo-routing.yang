module holo-routing {
  yang-version 1.1;
  namespace "http://holo-routing.org/yang/holo-routing";
  prefix holo-routing;

  import ietf-inet-types {
    prefix "inet";
    reference "RFC 6991: Common YANG Data Types";
  }

  import ietf-interfaces {
    prefix "if";
    reference "RFC 8343: A YANG Data Model for Interface Management";
  }

  import ietf-routing {
    prefix "rt";
  }

  import ietf-routing-types {
    prefix "rt-types";
  }

  import ietf-bier {
    prefix "bier";
  }

  organization
    "Holo Routing Stack";

  description
    "This module defines augment statements for the ietf-routing
    module.";

  identity kernel {
    // NOTE: base must be rt:routing-protocol (itself derived from
    // rt:control-plane-protocol): the ietf-routing RIB route
    // source-protocol identityref requires the routing-protocol base,
    // while everything needing control-plane-protocol still accepts
    // kernel through the derivation chain. Do not "simplify" this.
    base rt:routing-protocol;
    description
      "Routes imported from Linux kernel routing tables.";
  }

  augment "/rt:routing/rt:ribs/rt:rib" {
    description
      "Binding of a non-default RIB to a Linux kernel routing
       table, and import (leaking) of routes from other RIBs.";
    leaf kernel-table-id {
      type uint32 {
        range "1..4294967295";
      }
      description
        "Linux kernel routing table ID (RTA_TABLE) to import
         routes from, read-only: imported routes are never written
         back to the kernel table they were imported from, nor to
         any other kernel table.

         Only non-default RIBs may bind to a kernel table, and two
         RIBs of the same address family may not bind to the same
         kernel table.

         Security note: any process able to modify routes in the
         watched table can influence the leaked and redistributed
         routes, so the table must be writable only by trusted
         users.";
    }
    list import-rib {
      key "source-rib";
      description
        "Import (leak) routes of another RIB into this RIB.
         Leaked routes are not installed into the kernel: they
         exist in this RIB for protocol redistribution only.";
      leaf source-rib {
        type leafref {
          path "/rt:routing/rt:ribs/rt:rib/rt:name";
        }
        description
          "Name of the RIB to import routes from.";
      }
      leaf import-policy {
        type string;
        description
          "Name of the routing-policy policy-definition to run
           on imported routes. Routes rejected by the policy
           are not leaked. When unset, all routes are leaked.";
      }
    }
  }

  grouping resolved-next-hops {
    description
      "Next hops a recursive next hop resolved to.";
    list resolved-next-hop {
      description
        "Next hop of the route the address of the recursive next hop
         resolves through. Traffic follows these next hops.";
      choice next-hop-options {
        description
          "Options for resolved next hops.";
        case simple-next-hop {
          description
            "Next hop traffic is forwarded through.";
          leaf outgoing-interface {
            type if:interface-ref;
            description
              "Name of the outgoing interface.";
          }
          leaf address {
            type inet:ip-address;
            description
              "Address of the next hop.";
          }
          container mpls-label-stack {
            description
              "MPLS label stack pushed onto the traffic forwarded
               through the next hop.";
            list entry {
              key "id";
              description
                "MPLS label stack entry.";
              leaf id {
                type uint8;
                description
                  "Position of the entry in the label stack. The entry
                   with the smallest identifier is the top of the
                   stack.";
              }
              leaf label {
                type rt-types:mpls-label;
                description
                  "Label value.";
              }
            }
          }
        }
        case special-next-hop {
          description
            "The route the address resolves through discards traffic,
             and so does the route with the recursive next hop.";
          uses rt:special-next-hop;
        }
      }
    }
  }

  augment "/rt:routing/rt:ribs/rt:rib/rt:routes/rt:route/rt:next-hop/"
        + "rt:next-hop-options/rt:simple-next-hop" {
    description
      "Next hops the route's single recursive next hop resolved to.";
    uses resolved-next-hops;
  }

  augment "/rt:routing/rt:ribs/rt:rib/rt:routes/rt:route/rt:next-hop/"
        + "rt:next-hop-options/rt:next-hop-list/rt:next-hop-list/"
        + "rt:next-hop" {
    description
      "Next hops a recursive next hop in the route's list resolved
       to.";
    uses resolved-next-hops;
  }

  augment "/rt:routing" {
    container birts {
      description "BIER routing tables";
      list birt {
        key "sub-domain-id";
        description "BIER Routing table";
        config false;
        leaf sub-domain-id {
          config false;
          type uint8;
          description "BIER sub-domain-id";
        }
        list bfr-id {
          key "bfr-id";
          config false;
          leaf bfr-id {
            config false;
            type uint16;
            description "BFR identifier";
          }
          list birt-entry {
            key "bsl";
            config false;
            leaf bsl {
              config false;
              // FIXME: should be bier:bsl but got some issues with yang-rs
              type uint8;
              description "Bitstring length associated with the current entry";
            }
            leaf bfr-prefix {
              config false;
              type inet:ip-address;
              description "BFR's prefix";
            }
            leaf bfr-nbr {
              config false;
              type inet:ip-address;
              description "Neighbor BFR prefix";
            }
          }
        }
      }
    }

    container next-hop-tracking {
      config false;
      description
        "Next-hop addresses whose reachability is tracked on behalf of
         routing protocols.";
      list next-hop {
        key "address";
        description
          "Tracked next-hop address.";
        leaf address {
          type inet:ip-address;
          description
            "Next-hop address.";
        }
        container resolution {
          description
            "Route the next-hop address resolves through. Absent when
             the address is unreachable.";
          leaf prefix {
            type inet:ip-prefix;
            description
              "Destination prefix of the route.";
          }
          leaf protocol {
            type identityref {
              base rt:routing-protocol;
            }
            description
              "Routing protocol from which the route originated.";
          }
          leaf metric {
            type uint32;
            description
              "Metric of the route.";
          }
          uses rt:special-next-hop;
          list next-hop {
            description
              "Next hop of the route. Recursive next hops are replaced
               by the next hops they resolved to.";
            leaf outgoing-interface {
              type if:interface-ref;
              description
                "Name of the outgoing interface.";
            }
            leaf address {
              type inet:ip-address;
              description
                "Address of the next hop.";
            }
          }
        }
      }
    }
  }
}
