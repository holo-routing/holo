{
  "ietf-interfaces:interfaces": {
    "interface": [
      {
        "name": "lo",
        "type": "iana-if-type:ethernetCsmacd",
        "ietf-ip:ipv4": {}
      },
      {
        "name": "eth-rr",
        "type": "iana-if-type:ethernetCsmacd",
        "ietf-ip:ipv4": {}
      }
    ]
  },
  "ietf-routing:routing": {
    "control-plane-protocols": {
      "control-plane-protocol": [
        {
          "type": "ietf-bgp:bgp",
          "name": "test",
          "ietf-bgp:bgp": {
            "global": {
              "as": 65000,
              "identifier": "192.0.2.1",
              "afi-safis": {
                "afi-safi": [
                  {
                    "name": "iana-bgp-types:l3vpn-ipv4-unicast",
                    "enabled": true
                  },
                  {
                    "name": "iana-bgp-types:l3vpn-ipv6-unicast",
                    "enabled": true
                  }
                ]
              }
            },
            "neighbors": {
              "neighbor": [
                {
                  "remote-address": "192.0.2.2",
                  "peer-as": 65001,
                  "afi-safis": {
                    "afi-safi": [
                      {
                        "name": "iana-bgp-types:l3vpn-ipv4-unicast",
                        "enabled": true,
                        "apply-policy": {
                          "default-import-policy": "accept-route",
                          "default-export-policy": "accept-route"
                        }
                      },
                      {
                        "name": "iana-bgp-types:l3vpn-ipv6-unicast",
                        "enabled": true,
                        "apply-policy": {
                          "default-import-policy": "accept-route",
                          "default-export-policy": "accept-route"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
